{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/fast-check.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "ruff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/gate.sh",
            "args": [],
            "timeout": 600,
            "statusMessage": "Gate: ruff + mypy + tests"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "forge": {
      "source": {
        "source": "github",
        "repo": "mde-pach/forge"
      }
    }
  },
  "enabledPlugins": {
    "forge-monitor@forge": true
  }
}
